APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO

DATABASE_URL=sqlite:///./runtime_data/aac_image_generator.db
# Supabase/Postgres connection used for approved word sources and inventory writeback.
INVENTORY_DATABASE_URL=
# Server-only Supabase REST credentials used for storage and the sense-image RPC.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional RPC refresh for the Supabase aac_sense_images lookup/index.
SUPABASE_SENSE_IMAGES_SYNC_RPC_URL=
SUPABASE_SENSE_IMAGES_SYNC_FUNCTION=aac_sync_sense_images_from_inventory
SUPABASE_SENSE_IMAGES_STYLE=aac_current
SUPABASE_SENSE_IMAGES_STYLE_VERSION=1
SUPABASE_SENSE_IMAGES_BUCKET=aac-images-v1
SUPABASE_SENSE_IMAGES_SYNC_BATCH_SIZE=100
# Server-only Cloudflare R2 S3 credentials. Never expose these in Vercel/browser code.
CLOUDFLARE_R2_ENDPOINT=https://037b53bc4f90ba9db9537b7463aadd3f.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKETS=matalkimages
CLOUDFLARE_R2_DEFAULT_BUCKET=matalkimages
CLOUDFLARE_R2_COMPRESSION_QUALITY=79
# Public base URL used in aac_images.image_url, for example https://images.example.com
CLOUDFLARE_R2_PUBLIC_BASE_URL=
RUNTIME_DATA_ROOT=/Users/anna.cohen/Documents/Image generation/runtime_data

# Slack bot for remote status and control. See docs/slack_setup.md.
# Leaving SLACK_ALLOWED_USER_IDS empty allows every user in the workspace.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_ALLOWED_USER_IDS=
# Recipient for unsolicited alerts (batch finished, tasks stuck).
SLACK_ALERT_USER_ID=

OPENAI_API_KEY=
OPENAI_ASSISTANT_ID=
OPENAI_ASSISTANT_NAME=Prompt generator -JSON output
PROMPT_ENGINEER_MODE=responses_api
RESPONSES_PROMPT_ENGINEER_MODEL=gemini-3-flash-preview
RESPONSES_VECTOR_STORE_ID=vs_683f3d36223481919f59fc5623286253
VISUAL_STYLE_ID=warm_watercolor_storybook_kids_v3
VISUAL_STYLE_NAME=Warm Watercolor Storybook Kids Style v3
VISUAL_STYLE_PROMPT_BLOCK=
STAGE1_PROMPT_TEMPLATE=
STAGE3_PROMPT_TEMPLATE=
OPENAI_MODEL_VISION=gemini-3-flash-preview
STAGE3_CRITIQUE_MODEL=gemini-3-flash-preview
STAGE3_ANATOMY_CRITIQUE_MODEL=gemini-3.1-flash-lite
STAGE3_ACCESSIBILITY_CRITIQUE_MODEL=gpt-5.4
STAGE3_GENERATE_MODEL=gemini-3.1-flash-lite-image
POST_QUALITY_ACCESSIBILITY_CRITIQUE_MODEL=gemini-3.1-flash-lite
POST_QUALITY_ACCESSIBILITY_GENERATE_MODEL=gemini-3.1-flash-lite-image
VARIANT_CRITIQUE_MODEL=gemini-3.1-flash-lite
VARIANT_CORRECTION_MODEL=gemini-3.1-flash-lite-image
QUALITY_GATE_MODEL=gemini-3.1-flash-lite
GOOGLE_API_KEY=

# Still required for Stage 2 (flux-schnell) and any Imagen/Flux generation paths that remain on Replicate.
REPLICATE_API_TOKEN=
# Optional override. The backend calls Replicate directly by default.
REPLICATE_BASE_URL=https://api.replicate.com

QUALITY_THRESHOLD=95
MAX_OPTIMIZATION_LOOPS=3
MAX_API_RETRIES=3
STAGE_RETRY_LIMIT=3
WORKER_POLL_SECONDS=2
MAX_PARALLEL_RUNS=4
MAX_VARIANT_WORKERS=1
FLUX_IMAGEN_FALLBACK_ENABLED=true
